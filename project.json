{
  "name": "frontend",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev",
        "cwd": "apps/frontend"
      }
    },

    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "backend:build"
      ],
      "options": {
        "command": "npm run build:win",
        "cwd": "apps/frontend"
      }
    },

    "installer": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node -e \"console.log('Instalador em apps/frontend/dist/ (gerado pelo target build; use npm run smoke para validar)')\"",
        "cwd": "apps/frontend"
      }
    }
  }
}